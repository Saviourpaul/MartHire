APP_NAME=Marthire
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ORGANIZATION_DEMO_SETUP_EXPIRE_DAYS=7
ORGANIZATION_DEMO_UPDATE_EXPIRE_DAYS=7
ORGANIZATION_DEMO_BOOKING_URL=
ORGANIZATION_DEMO_CAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Laravel's server-side publish endpoint; REVERB_SERVER_* above controls where Reverb listens.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_CLIENT_TIMEOUT=3
REVERB_CLIENT_CONNECT_TIMEOUT=1
# Comma-separated browser origins allowed to open a WebSocket. Set the production site host here.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1,nearbyworks.test
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Workable (non-secret; subdomain and API token are per company in the database)
WORKABLE_API_VERSION=v3
WORKABLE_HOST_TEMPLATE="https://%s.workable.com/spi/%s"
WORKABLE_USER_AGENT="Marthire/1.0 (+ops@marthire.test)"
WORKABLE_FAKE=false
WORKABLE_SYNC_EMPTY_GUARD_MIN_OPEN=5
WORKABLE_SCHEMA_CACHE_MINUTES=15

# Application
APPLICATION_MAX_FILE_MB=5
APPLICATION_PAYLOAD_RETENTION_DAYS=30
